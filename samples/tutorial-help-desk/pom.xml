<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>io.a2aspring.samples</groupId>
    <artifactId>a2a-spring-020-help-desk-tutorial</artifactId>
    <version>1.0.0</version>
    <name>A2A Spring 0.2.0 Help Desk Tutorial</name>
    <description>Runnable tutorial app using the published A2A Spring 0.2.0 starter</description>

    <properties>
        <java.version>17</java.version>
        <a2a-spring.version>0.2.0</a2a-spring.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.soheilqalamkari</groupId>
            <artifactId>a2a-spring-boot-starter-web</artifactId>
            <version>${a2a-spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
